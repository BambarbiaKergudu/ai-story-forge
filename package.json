{
  "name": "ai-story-forge",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,css,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,css,md,yaml,yml}\""
  },
  "devDependencies": {
    "@asf/tsconfig": "workspace:*",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0"
  }
}
