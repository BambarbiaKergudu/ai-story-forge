# Скопируйте в `.env` в корне: `cp .env.example .env` (Windows: Copy-Item).
# `.env` в git не попадает. Значения ниже — только локальная разработка.
#
# Compose подставляет POSTGRES_* / порты в контейнеры.
# DATABASE_URL и REDIS_URL читает apps/api (Prisma и BullMQ) с хоста — поэтому localhost,
# не имена сервисов postgres/redis. У apps/web этих переменных нет и не будет.

POSTGRES_USER=asf
POSTGRES_PASSWORD=asf
POSTGRES_DB=asf
POSTGRES_PORT=5432

DATABASE_URL=postgresql://asf:asf@localhost:5432/asf

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# NestJS слушает этот порт (`apps/api`). Web — 3000, задан в scripts.
PORT=3001

# Next (серверные компоненты) ходит в API. На Vercel задайте явно.
# Локально web по умолчанию бьёт в http://127.0.0.1:3001 (не localhost: на Windows IPv6).
API_URL=http://127.0.0.1:3001

# Общий секрет HS256: сервер web подписывает вызов API, Nest его проверяет.
# Минимум 32 символа. На проде замените это локальное значение.
SERVICE_JWT_SECRET=dev-only-service-jwt-secret-change-me

# Картинки: черновик — fal FLUX schnell, цельный режим — Gemini.
# Пустые значения допустимы: API поднимется, генерация картинки упадёт при вызове.
# fal.ai: https://fal.ai/dashboard/keys
FAL_KEY=
# Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare R2. Пустые значения допустимы: API поднимется, загрузка кадра упадёт при вызове.
# Нужны все пять. R2_PUBLIC_BASE_URL — публичный домен бакета без хвоста, например https://pub-xxx.r2.dev
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# Текстовый шаг сценария. Ключ: https://console.groq.com/keys
# Пустое значение допустимо — API поднимется, генерация сценария упадёт при вызове.
GROQ_API_KEY=
# Модель со strict structured output. Менять не обязательно.
# GROQ_MODEL=openai/gpt-oss-20b
